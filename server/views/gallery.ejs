<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Etched In Stone | Gallery</title>
    <link rel="icon" href="/static/logo/S.png">
    <link rel="stylesheet" href="/static/stylesheets/gallery.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Stack+Sans+Notch:wght@200..700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Stack+Sans+Headline:wght@200..700&family=Stack+Sans+Text:wght@200..700&display=swap" rel="stylesheet">
</head>
<body>
    <!-- Preloader -->
    <div id="preloader">
        <img src="/static/logo/black.png" alt="">
    </div>

    <!-- Navigation -->
    <div class="navBar navBarScrolled" id="navBar">
        <nav>
            <div class="navSec1">
                <img id="navBarLogo" src="/static/logo/black.png" alt="">
            </div>
            <!-- ADD THIS: The Hamburger Icon -->
            <div class="hamburger" id="hamburgerBtn">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </div>
            <div class="navSec2">
                <button class="navBarButtonScrolled" id="homeBtn">Home</button>
                <button class="navBarButtonScrolled" id="servBtn">Services</button>
                <button class="navBarButtonScrolled" id="abtBtn">About</button>
                <button class="navBarButtonScrolled" id="contBtn">Contact</button>
            </div>
        </nav>
    </div> 

    <!-- Gallery Section -->
    <section id="fourthSec">
        <div class="fourthSecHeader">
            <h1 class="reveal-text"><span class="reveal-mask"><span class="reveal-line">Gallery</span></span></h1>
        </div>
        
        <div class="fourthSecImages">
            <div class="gallery-row">
                <img src="<%= items[0]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[1]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[2]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
            <div class="gallery-row">
                <img src="<%= items[3]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[4]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[5]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[6]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
            <div class="gallery-row">
                <img src="<%= items[7]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[8]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[9]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
            <div class="gallery-row">
                <img src="<%= items[3]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[4]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[5]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[6]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
            <div class="gallery-row">
                <img src="<%= items[7]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[8]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[9]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
            <div class="gallery-row">
                <img src="<%= items[3]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[4]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[5]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
                <img src="<%= items[6]?.imageUrl || '/static/images/background/driveway.jpg'%>" alt="">
            </div>
        </div>
        
        <!-- Decorative Shapes -->
        <img class="shapes s1" src="/static/shapes/triagy.png" alt="">
        <img class="shapes s2" src="/static/shapes/triag.png" alt="">
        <img class="shapes s3" src="/static/shapes/triay.png" alt="">
        <img class="shapes s4" src="/static/shapes/triayg.png" alt="">
        <img class="shapes s5" src="/static/shapes/yellowave.png" alt="">
        <img class="shapes s6" src="/static/shapes/greenwave.png" alt="">        
    </section>

    <!-- Footer Section -->
    <section id="sixthSec">
        <div class="sixthSecLogo">
            <img src="/static/logo/black.png" alt="">
        </div>
        <div class="sixthSecLinks">
            <a href="/services">Services</a>
            <a href="">About</a>
            <a href="">Gallery</a>
            <a href="">Contact</a>
        </div>
        <div class="sixthSecLinks1">
            <span>
                <a href="">etchedinstone</a>
                <img src="/static/icons/facebook.png" alt="">
            </span>
            <span>
                <a href="">etchedinstone</a>
