    <script>
        document.getElementById('uploadForm').addEventListener('submit', async function (e) {
            e.preventDefault(); // Stop the default HTML page refresh
            
            // 1. Grab the file, title, and button
            const imageFile = document.getElementById('galleryImage').files[0];
            const titleValue = document.getElementById('title').value;
            const submitBtn = document.getElementById('submitBtn');
            
            if (!imageFile) return;

            // 2. Visual feedback for the user
            submitBtn.innerText = "Compressing...";
            submitBtn.disabled = true;

            // 3. Compression Settings
            const options = {
                maxSizeMB: 4,          // Forces the file safely under Vercel's 4.5MB limit
                maxWidthOrHeight: 1920, // Resizes large photos to standard HD dimensions
                useWebWorker: true     // Prevents the browser from freezing during compression
            };

            try {
                // 4. Compress the Image
                const compressedFile = await imageCompression(imageFile, options);
                
                // 5. Package the data for Express (Mimicking a standard form)
                const formData = new FormData();
                formData.append('title', titleValue); 
                
                // CRITICAL: We use 'imageFile.name' here so Multer sees the original extension
                formData.append('galleryImage', compressedFile, imageFile.name); 

                // Update UI
                submitBtn.innerText = "Uploading to Server...";

                // 6. Send to your Express backend
                const response = await fetch('/gallery/upload', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    alert("Upload successful!");
                    window.location.reload(); // Refresh the page to show the new image
                } else {
                    throw new Error("Server rejected the upload.");
                }

            } catch (error) {
                console.error("Upload Error:", error);
                alert("Error during compression or upload. Check the console.");
            } finally {
                // 7. Reset the button state if something goes wrong
                submitBtn.innerText = "Upload";
                submitBtn.disabled = false;
            }
        });
    </script>
